# /etc/systemd/system/dpl-http.service, script at /opt/dpl/dpl-http.py
# Config: /opt/dpl/dpl-http.yaml (same directory as the script).
[Unit]
Description=dpl deploy over HTTP
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/dpl/dpl-http.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
