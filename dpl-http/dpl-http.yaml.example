# /opt/dpl/dpl-http.yaml — same directory as dpl-http.py.
# Edit this copy. An update of the script does not replace it.
# Restart after a change: systemctl restart dpl-http
#
# At least one of allow and tokens is required. A request is accepted when
# the client IP is listed or the bearer token matches. One is enough.
# Nothing below is active: uncomment a block and replace the placeholder.

# Port to listen on. Default 8099.
# port: 8099

# dpl base directory, if you changed it. Default /opt/dpl.
# Passed to `dpl` as DPL_BASE, so log reads and deploys use the same tree.
# base: /opt/dpl

# Client IPs accepted with no token. Exact IPv4, one per line. No CIDR, no names.
# allow:
#   - 203.0.113.10
#   - 198.51.100.7

# Bearer tokens accepted from any IP. The name (ci, laptop) is a label in this
# file; the client sends `token`, not the name.
#
# Each entry is a map so a later version can add `projects` (unit names, as in
# the URL) and limit that token to those units. Leave the key out until then:
# it is rejected, so a limit cannot be set and silently ignored. Once it is
# read, omitting it will mean every unit.
# tokens:
#   ci:
#     token: replace-with-a-long-random-string
#   laptop:
#     token: another-long-random-string
