#!/bin/sh
set -eu
{% for key, value in env|items -%}
{% set heredoc = "EOF_" ~ cuid() %}
export {{key}}=$(cat <<'{{heredoc}}'
{{value}}
{{heredoc}}
)
{% endfor -%}

if [ $# -eq 0 ]; then
{% if init -%}
{{ init }}
{% endif -%}
exec {{ cmd }}
fi

case "$1" in
check-tcp)
port=$(printf '%04X' "$2")
grep -qi ":${port} " /proc/net/tcp /proc/net/tcp6 2>/dev/null
;;
{% for timer in timers -%}
timer--{{ timer.name }})
{{ timer.script }}
;;
{% endfor -%}
*)
echo "unknown command: $1" >&2
exit 1
;;
esac
