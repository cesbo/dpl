[Unit]
Description=DPL HTTP server for {{ name }}
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
Delegate=yes
KillMode=mixed
TimeoutStopFailureMode=abort
ExecStart={{ dpl_bin }} --base {{ dpl_base }} start {{ name }}
ExecReload=/usr/bin/podman exec {{ container_name }} nginx -s reload
ExecStop={{ dpl_bin }} --base {{ dpl_base }} stop {{ name }}
Restart=always
RestartSec=2
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
