server {
    server_name {{ hosts | join(" ") }};
    listen 80;
    listen [::]:80;
{% if proxy %}
{% for ip in proxy.proxies %}
    set_real_ip_from {{ ip }};
{% endfor %}
    real_ip_header {{ proxy.header }};
{% endif %}
{% if custom_config %}

{{ custom_config }}
{% endif %}
{% for route in routes %}

    location {{ route.location }} {
{% if route.kind == "reverse_proxy" %}
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store" always;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if route.websocket %}
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}
        proxy_pass {{ route.target }};
{% elif route.kind == "uwsgi" %}
        include uwsgi_params;
        uwsgi_pass {{ route.target }};
{% elif route.kind == "fastcgi" %}
        include fastcgi_params;
        fastcgi_pass {{ route.target }};
{% elif route.kind == "serve_files" %}
        root {{ route.root }};
{% if route.spa %}
        try_files $uri $uri/ /index.html;
{% else %}
        try_files $uri $uri/ =404;
{% endif %}
{% elif route.kind == "redirect" %}
        return {{ 301 if route.permanent else 302 }} {{ route.target }};
{% elif route.kind == "return" %}
        return {{ route.status }}{% if route.body is not none %} "{{ route.body }}"{% endif %};
{% endif %}
    }
{% endfor %}
}
